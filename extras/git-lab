def read_text(arg: str) -> str:
    """*arg* itself, or all of stdin when it is ``-``."""
    text = sys.stdin.read() if arg == "-" else arg
    text = text.strip()
    if not text:
        sys.exit("Empty comment text.")
    return text


def parse_location(loc: str) -> tuple[str, int]:
    path, sep, line = loc.rpartition(":")
    if not sep or not path or not line.isdigit():
        sys.exit(f"Expected PATH:LINE, got '{loc}'.")
    return path, int(line)


def mr_paths(repo: Repo, mr: dict, refs: dict) -> set[str]:
    """New paths of the files the MR changes."""
    # Locally when the commits are fetched: the API's /diffs carries every
    # file's diff, heavy on a large MR.
    proc = subprocess.run(
        ["git", "diff", "--name-only", "-z", "-M", refs["base_sha"], refs["head_sha"]],
        capture_output=True,
        text=True,
        check=False,
    )
    if proc.returncode == 0:
        return {p for p in proc.stdout.split("\0") if p}
    diffs = or_exit(repo.get_all, f"{repo.mr_path(mr['iid'])}/diffs")
    return {d.get("new_path") for d in diffs}


def inline_position(repo: Repo, mr: dict, path: str, line: int) -> dict:
    """GitLab diff position for *line* of *path* at the MR head; line 0 is
    the whole file."""
    refs = mr.get("diff_refs") or {}
    if not refs.get("head_sha"):
        sys.exit("The MR has no diff refs yet.")
    # Line numbers only mean something when the checkout is what GitLab shows.
    if line != 0 and git("rev-parse", "HEAD") != refs["head_sha"]:
        sys.exit(
            f"HEAD is not the MR head ({refs['head_sha'][:10]}); "
            "check out the MR branch first."
        )
    # GitLab accepts a draft on a file outside the MR and then silently drops
    # it when published, so refuse up front.
    if path not in mr_paths(repo, mr, refs):
        sys.exit(
            f"{path} is not changed by MR !{mr['iid']}; "
            "use --general to post it as a general comment."
        )
    shas = {k: refs[k] for k in ("base_sha", "start_sha", "head_sha")}
    if line == 0:
        return {"position_type": "file", **shas, "new_path": path, "old_path": path}
    _, old = old_line_for(refs["base_sha"], refs["head_sha"], path, line)
    position = {
        "position_type": "text",
        **shas,
        "new_path": path,
        "old_path": path,
        "new_line": line,
    }
    if old is not None:
        position["old_line"] = old
    return position


def thread_json(disc: dict, me: str, lines: LineMapper | None = None) -> dict | None:
    """A GitLab discussion as ``{id, path, line, start_line, resolved,
    resolvable, resolved_by, resolved_by_me, comments = [{id, author, body,
    mine}]}``, or None when it has no comments (system notes only).
    ``resolved_by`` is the username that resolved it (None when open or
    unknown); ``mine`` and ``resolved_by_me`` compare with *me*, so callers
    can tell my own activity (in the browser too) from someone else's.

    An overview comment has path and line None; a file comment (or one on
    an image) has line 0. With *lines*, a line comment is mapped to the file
    on disk (a comment on a removed line, or made on an older version of the
    MR, lands where its code is now); ``start_line`` is the first line of a
    multi-line comment, else None. A one-off comment (not resolvable) counts as
    resolved when it is *me*'s (my summary, an approval message), so it does
    not come back as something to act on.
    """
    notes = [n for n in disc.get("notes") or [] if not n.get("system")]
    if not notes:
        return None
    pos = notes[0].get("position") or {}
    path = pos.get("new_path") or pos.get("old_path")
    line = (pos.get("new_line") or pos.get("old_line") or 0) if path else None
    start = None
    if path and pos.get("position_type") in ("file", "image"):
        line = 0
    elif path and lines:
        line, start = lines.position(pos)
    resolvable = any(n.get("resolvable") for n in notes)
    author = (notes[0].get("author") or {}).get("username")
    resolved = bool(disc.get("resolved")) if resolvable else author == me
    # Resolving a thread sets resolved_by on each of its resolvable notes.
    resolver = None
    if resolvable and resolved:
        for n in notes:
            resolver = (n.get("resolved_by") or {}).get("username") or resolver
    return {
        "id": disc["id"],
        "path": path,
        "line": line,
        "start_line": start,
        "resolved": resolved,
        "resolvable": resolvable,
        "resolved_by": resolver,
        "resolved_by_me": resolver is not None and resolver == me,
        "comments": [
            {
                "id": str(n["id"]),
                "author": (n.get("author") or {}).get("username", "unknown"),
                "body": n.get("body") or "",
                "mine": (n.get("author") or {}).get("username") == me,
            }
            for n in notes
        ],
    }


def emit_id(args: argparse.Namespace, ident: Any, what: str) -> None:
    if args.json:
        print(json.dumps({"id": str(ident)}))
    else:
        print(f"{what} {ident}")


def cmd_comment_list(args: argparse.Namespace) -> None:
    repo = repo_from_cwd()
    mr = resolve_mr(repo, args.mr)
    # Independent and latency bound: fetch them concurrently.
    with ThreadPoolExecutor(max_workers=2) as pool:
        disc_job = pool.submit(
            or_exit, repo.get_all, f"{repo.mr_path(mr['iid'])}/discussions"
        )
        user_job = pool.submit(or_exit, repo.api, "GET", "/api/v4/user")
        discussions, me = disc_job.result(), user_job.result()["username"]
    lines = LineMapper()
    threads = [t for d in discussions if (t := thread_json(d, me, lines))]
    if args.json:
        print(json.dumps(threads, indent=2))
        return
    for t in sorted(threads, key=lambda t: (t["path"] or "", t["line"] or 0)):
        state = " [resolved]" if t["resolved"] else ""
        span = f"{t['start_line']}-{t['line']}" if t["start_line"] else t["line"]
        where = f"{t['path']}:{span}" if t["path"] else "(overview)"
        print(f"{where}{state}  ({t['id'][:8]})")
        for c in t["comments"]:
            first, *rest = c["body"].splitlines() or [""]
            print(f"  @{c['author']}: {first}")
            for line in rest:
                print(f"    {line}")


def cmd_comment_add(args: argparse.Namespace) -> None:
    repo = repo_from_cwd()
    path, line = parse_location(args.location) if args.location else (None, 0)
    mr = resolve_mr(repo, args.mr, full=bool(path) and not args.general)
    text = read_text(args.text)
    mr_api = repo.mr_path(mr["iid"])
    if args.general and path:
        # Not anchored to the diff, so the location goes into the text.
        text = f"`{path}:{line}`\n\n{text}"
    if args.general or not path:
        # A thread on the MR itself; a draft without a position publishes as
        # a resolvable thread too.
        if args.draft:
            res = or_exit(repo.api, "POST", f"{mr_api}/draft_notes", {"note": text})
            emit_id(args, res["id"], "draft")
        else:
            res = or_exit(repo.api, "POST", f"{mr_api}/discussions", {"body": text})
            emit_id(args, res["id"], "thread")
        return
    position = inline_position(repo, mr, path, line)
    if args.draft:
        res = or_exit(
            repo.api,
            "POST",
            f"{mr_api}/draft_notes",
            {"note": text, "position": position},
        )
        emit_id(args, res["id"], "draft")
    else:
        res = or_exit(
            repo.api,
            "POST",
            f"{mr_api}/discussions",
            {"body": text, "position": position},
        )
        emit_id(args, res["id"], "thread")


def cmd_comment_reply(args: argparse.Namespace) -> None:
    repo = repo_from_cwd()
    mr = resolve_mr(repo, args.mr)
    text = read_text(args.text)
    mr_api = repo.mr_path(mr["iid"])
    if args.draft:
        res = or_exit(
            repo.api,
            "POST",
            f"{mr_api}/draft_notes",
            {"note": text, "in_reply_to_discussion_id": args.thread},
        )
        emit_id(args, res["id"], "draft")
    else:
        res = or_exit(
            repo.api,
            "POST",
            f"{mr_api}/discussions/{args.thread}/notes",
            {"body": text},
        )
        emit_id(args, res["id"], "note")


def cmd_comment_resolve(args: argparse.Namespace) -> None:
    repo = repo_from_cwd()
    mr = resolve_mr(repo, args.mr)
    resolved = args.cmd_name == "resolve"
    path = f"{repo.mr_path(mr['iid'])}/discussions/{args.thread}"
    try:
        repo.api("PUT", path, {"resolved": resolved})
    except GitLabError as exc:
        # A one-off comment has no resolved state on GitLab: callers keep it
        # locally, so that is not an error.
        disc = or_exit(repo.api, "GET", path)
        if any(n.get("resolvable") for n in disc.get("notes") or []):
            sys.exit(str(exc))
        print(f"{args.thread} is not resolvable on GitLab; state kept locally")
        return
    print(f"{'resolved' if resolved else 'reopened'} {args.thread}")


def list_drafts(repo: Repo, mr: dict) -> list[dict]:
    return or_exit(repo.get_all, f"{repo.mr_path(mr['iid'])}/draft_notes")


def parse_ids(arg: str) -> set[str]:
    ids = {i.strip() for i in arg.split(",") if i.strip()}
    if not ids:
        # Never widen an empty selection to all drafts.
        sys.exit("--only needs at least one draft id")
    return ids


def publish_only(
    repo: Repo, mr_api: str, drafts: list[dict], ids: set[str]
) -> list[str]:
    """Publish the drafts *ids* and return them. One bulk publish when they
    are all the pending drafts (one notification, like the web's submit);
    otherwise one by one, so other drafts (a review started in the browser)
    stay pending. On failure exits with the ids published so far as JSON."""
    pending = {str(d["id"]) for d in drafts}
    missing = ids - pending
    if missing:
        sys.exit(f"not pending drafts: {', '.join(sorted(missing))}")
    if ids == pending:
        or_exit(repo.api, "POST", f"{mr_api}/draft_notes/bulk_publish")
        return sorted(ids)
    published: list[str] = []
    for ident in sorted(ids, key=lambda i: int(i) if i.isdigit() else 0):
        try:
            repo.api("PUT", f"{mr_api}/draft_notes/{ident}/publish")
        except GitLabError as exc:
            print(json.dumps({"published": published}))
            sys.exit(str(exc))
        published.append(ident)
    return published


def cmd_review_submit(args: argparse.Namespace) -> None:
    repo = repo_from_cwd()
    mr = resolve_mr(repo, args.mr)
    mr_api = repo.mr_path(mr["iid"])
    drafts = list_drafts(repo, mr)
    only = parse_ids(args.only) if args.only is not None else None
    # `-m -` with nothing on stdin means no summary, so callers can always
    # pass the summary they have.
    summary = ""
    if args.message == "-":
        summary = sys.stdin.read().strip()
    elif args.message:
        summary = read_text(args.message)
    if not (drafts or summary or only):
        if args.json:
            print(json.dumps({"published": []}))
        else:
            print(f"MR !{mr['iid']}: nothing to submit")
        return
    if summary:
        or_exit(repo.api, "POST", f"{mr_api}/notes", {"body": summary})
        if not args.json:
            print("summary posted")
    if only is not None:
        published = publish_only(repo, mr_api, drafts, only)
    elif drafts:
        or_exit(repo.api, "POST", f"{mr_api}/draft_notes/bulk_publish")
        published = [str(d["id"]) for d in drafts]
    else:
        published = []
    if args.json:
        print(json.dumps({"published": published}))
        return
    if published:
        print(f"published {len(published)} pending comments")
    print(mr_url(repo, mr))


def cmd_review_discard(args: argparse.Namespace) -> None:
    repo = repo_from_cwd()
    mr = resolve_mr(repo, args.mr)
    mr_api = repo.mr_path(mr["iid"])
    pending = [str(d["id"]) for d in list_drafts(repo, mr)]
    # A selected draft no longer pending was published or deleted already.
    ids = (
        [i for i in pending if i in parse_ids(args.only)]
        if args.only is not None
        else pending
    )
    for ident in ids:
        or_exit(repo.api, "DELETE", f"{mr_api}/draft_notes/{ident}")
    print(f"discarded {len(ids)} pending comments")


# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------
def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="git-lab",
        description=textwrap.dedent(__doc__ or ""),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    sub = p.add_subparsers(dest="cmd", required=True)

    mr = sub.add_parser("mr", help="Merge request operations.").add_subparsers(
        dest="mr_cmd", required=True
    )
    ls = mr.add_parser("list", help="List MRs.")
    ls.add_argument("--all", action="store_true", help="Include merged and closed MRs.")
    ls.add_argument("--drafts", action="store_true", help="Include draft MRs.")
    ls.add_argument(
        "--recursive", action="store_true", help="Include submodule projects."
    )
    ls.add_argument("--json", action="store_true", help="Print full MR data as JSON.")
    ls.set_defaults(fn=cmd_mr_list)

    co = mr.add_parser("checkout", help="Check out an MR's source branch.")
    co.add_argument("ref", metavar="REF")
    co.add_argument(
        "-r", "--review", action="store_true", help="Also assign yourself as reviewer."
    )
    co.set_defaults(fn=cmd_mr_checkout)

    ra = mr.add_parser("review-assign", help="Assign yourself as reviewer.")
    ra.add_argument("ref", metavar="REF")
    ra.set_defaults(fn=cmd_mr_review_assign)

    tg = mr.add_parser("target", help="Print the MR target ref.")
    tg.add_argument("ref", metavar="REF", nargs="?")
    tg.add_argument(
        "--refresh",
        action="store_true",
        help="Ask GitLab even when cached, updating the cache.",
    )
    tg.set_defaults(fn=cmd_mr_target)

    ap = mr.add_parser("approve", help="Approve the MR.")
    ap.add_argument("ref", metavar="REF", nargs="?")
    ap.add_argument("-m", "--message", help="General comment to post first.")
    ap.set_defaults(fn=cmd_mr_approve)

    inf = mr.add_parser("info", help="Show the MR of the current branch.")
    inf.add_argument("ref", metavar="REF", nargs="?")
    inf.add_argument("--json", action="store_true")
    inf.set_defaults(fn=cmd_mr_info)

    def mr_opt(sp: argparse.ArgumentParser) -> None:
        sp.add_argument(
            "--mr", type=int, metavar="IID", help="Default: MR of the current branch."
        )

    comment = sub.add_parser("comment", help="Inline MR comments.").add_subparsers(
        dest="comment_cmd", required=True
    )
    cl = comment.add_parser("list", help="List threads.")
    mr_opt(cl)
    cl.add_argument("--json", action="store_true")
    cl.set_defaults(fn=cmd_comment_list)

    ca = comment.add_parser(
        "add", help="Start a thread at PATH:LINE (PATH:0 file; none: overview)."
    )
    mr_opt(ca)
    ca.add_argument("location", metavar="PATH:LINE", nargs="?")
    ca.add_argument("text", metavar="TEXT|-", help="'-' reads stdin.")
    ca.add_argument("--draft", action="store_true", help="Pending until review submit.")
    ca.add_argument(
        "--general",
        action="store_true",
        help="MR thread quoting PATH:LINE, for files outside the diff.",
    )
    ca.add_argument("--json", action="store_true")
    ca.set_defaults(fn=cmd_comment_add)

    cr = comment.add_parser("reply", help="Reply to a thread.")
    mr_opt(cr)
    cr.add_argument("thread", metavar="ID")
    cr.add_argument("text", metavar="TEXT|-", help="'-' reads stdin.")
    cr.add_argument("--draft", action="store_true", help="Pending until review submit.")
    cr.add_argument("--json", action="store_true")
    cr.set_defaults(fn=cmd_comment_reply)

    for name, helptext in (
        ("resolve", "Resolve a thread."),
        ("unresolve", "Reopen a thread."),
    ):
        cs = comment.add_parser(name, help=helptext)
        mr_opt(cs)
        cs.add_argument("thread", metavar="ID")
        cs.set_defaults(fn=cmd_comment_resolve, cmd_name=name)

    review = sub.add_parser("review", help="Pending (draft) review.").add_subparsers(
        dest="review_cmd", required=True
    )
    rb = review.add_parser("submit", help="Publish all pending comments.")
    mr_opt(rb)
    rb.add_argument("-m", "--message", metavar="TEXT|-", help="Summary comment.")
    rb.add_argument(
        "--only", metavar="IDS", help="Only these drafts (comma-separated)."
    )
    rb.add_argument("--json", action="store_true", help="Print {published: [ids]}.")
    rb.set_defaults(fn=cmd_review_submit)

    rd = review.add_parser("discard", help="Delete all pending comments.")
    mr_opt(rd)
    rd.add_argument(
        "--only", metavar="IDS", help="Only these drafts (comma-separated)."
    )
    rd.set_defaults(fn=cmd_review_discard)

    return p


def main() -> None:
    args = build_parser().parse_args()
    args.fn(args)


if __name__ == "__main__":
    main()
