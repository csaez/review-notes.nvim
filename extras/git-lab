# CLI
# ---------------------------------------------------------------------------
def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="git-lab",
        description=textwrap.dedent(__doc__ or ""),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    sub = p.add_subparsers(dest="cmd", required=True)

    def group(name: str, helptext: str) -> Any:
        parser = sub.add_parser(name, help=helptext)
        return parser.add_subparsers(dest=f"{name}_cmd", required=True)

    def command(
        parent: Any, name: str, fn: Callable, helptext: str, *flags: str
    ) -> argparse.ArgumentParser:
        """A subcommand; *flags* are the common ones it takes: ``refs``
        (any number of MR references), ``mr`` (--mr IID), ``json``,
        ``draft``, ``text`` (TEXT|-), ``only`` (--only IDS)."""
        sp = parent.add_parser(name, help=helptext)
        sp.set_defaults(fn=fn, cmd_name=name)
        if "refs" in flags:
            sp.add_argument(
                "refs",
                metavar="REF",
                nargs="*",
                help="Default: the current branch's MR.",
            )
        if "mr" in flags:
            sp.add_argument(
                "--mr",
                type=int,
                metavar="IID",
                help="Default: MR of the current branch.",
            )
        if "json" in flags:
            sp.add_argument("--json", action="store_true")
        if "draft" in flags:
            sp.add_argument(
                "--draft", action="store_true", help="Pending until review submit."
            )
        if "only" in flags:
            sp.add_argument(
                "--only", metavar="IDS", help="Only these drafts (comma-separated)."
            )
        return sp

    mr = group("mr", "Merge request operations.")
    ls = command(mr, "list", cmd_mr_list, "List MRs.", "json")
    ls.add_argument("--all", action="store_true", help="Include merged and closed MRs.")
    ls.add_argument("--drafts", action="store_true", help="Include draft MRs.")
    ls.add_argument(
        "--recursive", action="store_true", help="Include submodule projects."
    )
    ls.add_argument(
        "--approvals",
        action="store_true",
        help="Add who approved and who reviews (one request per MR).",
    )

    co = command(mr, "checkout", cmd_mr_checkout, "Check out an MR's source branch.")
    co.add_argument("ref", metavar="REF")
    co.add_argument(
        "-r", "--review", action="store_true", help="Also assign yourself as reviewer."
    )

    ra = command(
        mr,
        "review-assign",
        cmd_mr_review_assign,
        "Assign yourself as reviewer.",
        "refs",
    )
    ra.add_argument(
        "--if-free",
        action="store_true",
        help="Refuse when someone else reviews it already.",
    )
    ra.add_argument("--force", action="store_true", help="With --if-free: join anyway.")

    tg = command(mr, "target", cmd_mr_target, "Print the MR target ref.", "refs")
    tg.add_argument(
        "--refresh",
        action="store_true",
        help="Ask GitLab even when cached, updating the cache.",
    )

    ap = command(mr, "approve", cmd_mr_approve, "Approve the MR.", "refs")
    ap.add_argument("-m", "--message", help="General comment to post first.")

    command(mr, "info", cmd_mr_info, "Show the MR.", "refs", "json")

    comment = group("comment", "Inline MR comments.")
    cl = command(comment, "list", cmd_comment_list, "List threads.", "mr", "json")
    cl.add_argument(
        "--with-mr",
        action="store_true",
        help="Print {mr, threads} as JSON: the MR and its state too.",
    )

    ca = command(
        comment,
        "add",
        cmd_comment_add,
        "Start a thread at PATH:LINE (PATH:0 file; none: overview).",
        "mr",
        "draft",
        "json",
    )
    ca.add_argument("location", metavar="PATH:LINE", nargs="?")
    ca.add_argument("text", metavar="TEXT|-", help="'-' reads stdin.")
    ca.add_argument(
        "--general",
        action="store_true",
        help="MR thread quoting PATH:LINE, for files outside the diff.",
    )

    cr = command(
        comment, "reply", cmd_comment_reply, "Reply to a thread.", "mr", "draft", "json"
    )
    cr.add_argument("thread", metavar="ID")
    cr.add_argument("text", metavar="TEXT|-", help="'-' reads stdin.")

    for name, helptext in (
        ("resolve", "Resolve threads."),
        ("unresolve", "Reopen threads."),
    ):
        cs = command(comment, name, cmd_comment_resolve, helptext, "mr")
        cs.add_argument("threads", metavar="ID", nargs="+")

    review = group("review", "Pending (draft) review.")
    rb = command(
        review, "submit", cmd_review_submit, "Publish pending comments.", "mr", "only"
    )
    rb.add_argument("-m", "--message", metavar="TEXT|-", help="Summary comment.")
    rb.add_argument("--json", action="store_true", help="Print {published: [ids]}.")

    command(
        review, "discard", cmd_review_discard, "Delete pending comments.", "mr", "only"
    )
    return p


def main() -> None:
    args = build_parser().parse_args()
    try:
        args.fn(args)
    except GitLabError as exc:
        fail(str(exc), exc.status)


if __name__ == "__main__":
    main()
