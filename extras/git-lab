def cmd_mr_list(args: argparse.Namespace) -> None:
    state = "all" if args.all else "opened"
    result = collect_mrs(repo_from_cwd(), args.recursive, state, args.drafts)
    if args.json:
        print(json.dumps(result, indent=2))
        return
    for mr in result:
        author = (mr.get("author") or {}).get("username", "?")
        fields = [
            mr["_ref"],
            f"@{author}",
            mr.get("source_branch", "?"),
            mr.get("title", ""),
            ", ".join(mr.get("labels") or []),
        ]
        # Tabs and newlines would break the columns.
        print("\t".join(" ".join(f.split()) for f in fields))


def review_assign(repo: Repo, mr: dict) -> None:
    user = or_exit(repo.api, "GET", "/api/v4/user")
    reviewers = [r["id"] for r in mr.get("reviewers") or []]
    if user["id"] not in reviewers:
        or_exit(
            repo.api,
            "PUT",
            repo.mr_path(mr["iid"]),
            {"reviewer_ids": reviewers + [user["id"]]},
        )
    print(f"Assigned @{user['username']} as reviewer of !{mr['iid']}")


def cmd_mr_review_assign(args: argparse.Namespace) -> None:
    repo, iid = parse_ref(repo_from_cwd(), args.ref)
    review_assign(repo, get_mr(repo, iid))


def checkout_mr(mr: dict, path: str) -> str:
    """Check out *mr* in the repository at *path*; return the local branch."""

    # No submodule recursion (a user config may set it): an MR may point a
    # submodule at a commit no branch has, so switch would abort on it;
    # `submodule update` below fetches it by SHA instead.
    def run(*args: str, check: bool = True) -> subprocess.CompletedProcess:
        cmd = ["git", "-c", "submodule.recurse=false", "-C", path, *args]
        proc = subprocess.run(cmd, capture_output=True, text=True, check=False)
        if check and proc.returncode != 0:
            sys.exit(
                f"git {' '.join(args)} failed in {path}:\n"
                + (proc.stderr or proc.stdout).strip()
            )
        return proc

    # Refuse on tracked changes: switch/rebase could stop halfway and leave
    # the checkout on another branch or mid-rebase.
    if run("status", "--porcelain", "--untracked-files=no").stdout.strip():
        sys.exit(f"Uncommitted changes in {path}; commit or stash first.")

    source = mr["source_branch"]
    fork = mr.get("source_project_id") != mr.get("target_project_id")
    if fork:
        # Fork branches are not on origin; GitLab mirrors every MR head under
        # refs/merge-requests. A namespaced local branch keeps a fork's "main"
        # from clashing with ours.
        branch = f"mr/{mr['iid']}"
        upstream = f"refs/remotes/origin/{branch}"
        run("fetch", "origin", f"+refs/merge-requests/{mr['iid']}/head:{upstream}")
    else:
        branch = source
        upstream = f"refs/remotes/origin/{source}"
        run("fetch", "origin", source)

    if (
        run(
            "rev-parse", "--verify", "--quiet", f"refs/heads/{branch}", check=False
        ).returncode
        == 0
    ):
        run("switch", branch)
        if run("merge", "--ff-only", upstream, check=False).returncode != 0:
            # Force-pushed upstream: the reflog of the upstream ref tells which
            # local commits were really ours (as `git pull --rebase` does).
            fp = run("merge-base", "--fork-point", upstream, "HEAD", check=False)
            fork_point = fp.stdout.strip()
            if fp.returncode != 0 or not fork_point:
                sys.exit(
                    f"{branch} diverged from {upstream} (no fork point); resolve manually."
                )
            if fork_point == run("rev-parse", "HEAD").stdout.strip():
                run("reset", "--keep", upstream)
            else:
                print(f"Replaying local commits onto {upstream}", file=sys.stderr)
                run("rebase", "--onto", upstream, fork_point)
    elif fork:
        # No tracking: the MR ref is read-only, nothing to push back to.
        run("switch", "-c", branch, "--no-track", upstream)
    else:
        run("switch", "-c", branch, "--track", f"origin/{source}")
    # A main-repo MR may move submodule pointers.
    if path == ".":
        run("submodule", "update", "--init", "--recursive")
    return branch


def cmd_mr_checkout(args: argparse.Namespace) -> None:
    repo, iid = parse_ref(repo_from_cwd(), args.ref)
    mr = get_mr(repo, iid)
    branch = checkout_mr(mr, repo.path)
    if mr.get("target_branch"):
        store_target(branch, f"origin/{mr['target_branch']}", cwd=repo.path)
    print(f"!{mr['iid']}: on {branch} in {repo.path}")
    if args.review:
        review_assign(repo, mr)


def guess_target(repo: Repo, branch: str) -> str:
    """Guess the target for a branch without an MR: the nearest protected branch.

    Exits 1 when unknown, 2 when *branch* is itself protected.
    """
    try:
        protected = {b["name"] for b in repo.get_all(f"{repo.base}/protected_branches")}
    except GitLabError:
        sys.exit(1)
    if branch in protected:
        print(
            f"'{branch}' is protected and unlikely to have an MR target.",
            file=sys.stderr,
        )
        sys.exit(2)
    remote = {
        ln.strip().removeprefix("origin/")
        for ln in git("branch", "-r", check=False).splitlines()
        if ln.strip().startswith("origin/") and "->" not in ln
    }
    candidates = protected & remote
    if not candidates:
        sys.exit(1)

    def ahead(b: str) -> int:
        out = git("rev-list", "--count", f"origin/{b}..HEAD", check=False)
        return int(out) if out.isdigit() else sys.maxsize

    return f"origin/{min(candidates, key=ahead)}"


def cmd_mr_target(args: argparse.Namespace) -> None:
    """Print ``origin/<target>``; exit 1 when unknown, 2 on a protected branch."""
    if args.ref is not None:
        repo, iid = parse_ref(repo_from_cwd(), args.ref)
        target = get_mr(repo, iid).get("target_branch")
        if not target:
            sys.exit(1)
        print(f"origin/{target}")
        return
    branch = current_branch()
    # Targets rarely change: answer from the cache and let callers refresh it
    # in the background. Unknown/protected results are not cached.
    cached = git("config", "--get", target_key(branch), check=False)
    if cached and not args.refresh:
        print(cached)
        return
    repo = repo_from_cwd()
    mrs = mrs_for_branch(repo, branch)
    if mrs and mrs[0].get("target_branch"):
        target = f"origin/{mrs[0]['target_branch']}"
    elif cached:
        # No MR by this name (a fork MR's mr/IID, or merged): a guess must not
        # replace what checkout or a real MR stored.
        target = cached
    else:
        target = guess_target(repo, branch)
    store_target(branch, target)
    print(target)


def cmd_mr_approve(args: argparse.Namespace) -> None:
    repo = repo_from_cwd()
    if args.ref is not None:
        repo, iid = parse_ref(repo, args.ref)
        mr = get_mr(repo, iid)
    else:
        mr = resolve_mr(repo, None)
    print(f"Approving MR !{mr['iid']}: {mr.get('title', '')}\n  {mr_url(repo, mr)}")
    if args.message:
        or_exit(
            repo.api, "POST", f"{repo.mr_path(mr['iid'])}/notes", {"body": args.message}
        )
        print("  comment posted")
    or_exit(repo.api, "POST", f"{repo.mr_path(mr['iid'])}/approve")
    print("  approved")


def cmd_mr_info(args: argparse.Namespace) -> None:
    repo = repo_from_cwd()
    if args.ref is not None:
        repo, iid = parse_ref(repo, args.ref)
        mr = get_mr(repo, iid)
    else:
        mr = resolve_mr(repo, None)
    info = {
        "ref": f"!{mr['iid']}",
        "iid": mr["iid"],
        "title": mr.get("title", ""),
        "url": mr_url(repo, mr),
        "source": mr.get("source_branch"),
        "target": f"origin/{mr['target_branch']}" if mr.get("target_branch") else None,
        "author": (mr.get("author") or {}).get("username"),
        "state": mr.get("state"),
        "draft": bool(mr.get("draft")),
    }
    if args.json:
        print(json.dumps(info))
    else:
        print(f"{info['ref']} {info['title']}\n  {info['source']} -> {info['target']}\n  {info['url']}")


