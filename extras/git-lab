#!/usr/bin/env python3
"""
git-lab -- GitLab merge request tooling for the current repository.

Subcommands:
    mr list [--all] [--drafts] [--recursive] [--json] [--approvals]
                            Print MRs as ref<TAB>author<TAB>branch<TAB>title<TAB>labels,
                            or JSON (with the ref as _ref). --approvals adds
                            who approved and who reviews (a column; _review
                            in JSON, as in `mr info`), one request per MR.
    mr checkout REF [-r|--review]
                            Check out the MR's source branch (fork MRs as
                            mr/IID), in the submodule for a submodule's MR,
                            fast-forwarding or replaying local commits over a
                            force-push. --review: also assign yourself as
                            reviewer.
    mr review-assign [REF...] [--if-free [--force]]
                            Add yourself as reviewer of the MRs. --if-free refuses when someone
                            else reviews it already.
    mr target [REF...] [--refresh]
                            Print the MR target refs (origin/<branch>), one per line.
                            The current branch's target is cached in
                            branch.<name>.gitlab-target (set by checkout too);
                            --refresh asks GitLab and updates it.
    mr approve [REF...] [-m MSG]
                            Approve the MRs, optionally commenting.
    mr info [REF...] [--json]
                            The MRs, one JSON object per line: {ref, iid, title, url,
                            source, target, author, sha, state, draft, me,
                            reviewers, approved, approved_by, approvals_left};
                            without REF, the latest merged or closed one of
                            the branch when none is open.
    comment list [--mr IID] [--json] [--with-mr]
                            Threads: {id, path, line, start_line, resolved,
                            resolvable, resolved_by, resolved_by_me,
                            comments = [{author, body, mine}]}. Lines are those of the files
                            on disk (start_line: multi-line comments). Overview
                            threads (the whole MR) have path and line null;
                            line 0 is about a whole file.
                            --with-mr prints {mr, threads}: mr as `mr info`,
                            plus `successor` (the open MR of the branch) when
                            this one is merged or closed. Without --mr, a
                            merged or closed MR of the branch is listed too.
    comment add [--mr IID] [PATH:LINE] TEXT|- [--draft] [--general] [--json]
                            Start a thread; '-' reads the text from stdin.
                            No location starts an overview thread, ``PATH:0``
                            a file thread.
                            --draft keeps it pending until ``review submit``.
                            Files outside the MR are refused unless --general,
                            which posts an overview thread quoting PATH:LINE.
    comment reply [--mr IID] ID TEXT|- [--draft] [--json]
    comment resolve|unresolve [--mr IID] ID...
    review submit [--mr IID] [-m TEXT|-] [--only IDS] [--json]
                            Publish all pending comments, with an optional summary
                            comment ('-' reads stdin; empty means none).
                            --only publishes just those drafts (comma-separated
                            ids), leaving others pending; --json prints
                            {published: [ids]}, also when it fails part way.
    review discard [--mr IID] [--only IDS]
                            Delete all pending comments, or just those drafts.

REF is an MR of this repository or of one of its submodules: IID, !IID,
group/project!IID or the MR URL. Without REF (and --mr defaults to) the open
MR of the current branch. Commands taking several act on each in turn.

Exit status: 1 an error, 3 GitLab unreachable (offline, timeout), 4 no
access (401, 403, or a project not found), 5 no such MR (404, or no open MR
for the branch), 6 the remote is not a GitLab server.

To pick an MR interactively, pipe ``mr list`` into a picker, e.g.:
    git-lab mr checkout "$(git-lab mr list --recursive | fzf | cut -f1)"

Environment:
    GITLAB_TOKEN   required -- token with api scope
    GITLAB_HOST    optional -- overrides the host parsed from the git remote
    GITLAB_TIMEOUT optional -- seconds per request (default 10)
"""

import argparse
import http.client
import json
import os
import re
import ssl
import subprocess
import sys
import textwrap
import urllib.error
import urllib.parse
import urllib.request
from concurrent.futures import ThreadPoolExecutor
from dataclasses import dataclass
from functools import cache
from typing import Any, Callable, NoReturn

EXIT_ERROR = 1
EXIT_UNREACHABLE = 3
EXIT_NO_ACCESS = 4
EXIT_NO_MR = 5
EXIT_NOT_GITLAB = 6


class GitLabError(Exception):
    """A failed GitLab call; *status* is the exit status it maps to."""

    def __init__(self, message: str, status: int = EXIT_ERROR):
        super().__init__(message)
        self.status = status


def fail(message: str, status: int = EXIT_ERROR) -> NoReturn:
    print(message, file=sys.stderr)
    sys.exit(status)


# ---------------------------------------------------------------------------
# Git
# ---------------------------------------------------------------------------
def git(*args: str, cwd: str | None = None, check: bool = True) -> str:
    try:
        return subprocess.check_output(
            ["git", *args], cwd=cwd, stderr=subprocess.DEVNULL, text=True
        ).strip()
    except subprocess.CalledProcessError as exc:
        if check:
            fail(f"git {' '.join(args)} failed (exit {exc.returncode})")
        return ""


def current_branch() -> str:
    branch = git("branch", "--show-current", check=False)
    # Mid-rebase HEAD is detached; the rebased branch is still the one whose
    # MR applies (same fallback in review-notes.nvim and pi).
    for state in ("rebase-merge", "rebase-apply"):
        if branch:
            break
        head = git("rev-parse", "--git-path", f"{state}/head-name", check=False)
        if head and os.path.isfile(head):
            with open(head) as fh:
                branch = fh.read().strip().removeprefix("refs/heads/")
    if not branch:
        fail("Not on a named branch -- cannot auto-detect the MR.")
    return branch


def target_key(branch: str) -> str:
    return f"branch.{branch}.gitlab-target"


def store_target(branch: str, target: str, cwd: str | None = None) -> None:
    """Cache *target* in the branch config; git drops it with the branch."""
    key = target_key(branch)
    if git("config", "--get", key, cwd=cwd, check=False) != target:
        git("config", key, target, cwd=cwd, check=False)


def parse_remote(url: str) -> tuple[str, str] | None:
    """Return (host, project_path) for an SSH or HTTPS remote URL."""
    url = url.strip()
    if url.startswith("git@"):
        host, sep, path = url[4:].partition(":")
        return (host, path.removesuffix(".git")) if sep else None
    parsed = urllib.parse.urlparse(url)
    if not parsed.scheme or not parsed.netloc:
        return None
    host = parsed.netloc.rpartition("@")[2]
    return host, parsed.path.lstrip("/").removesuffix(".git")


_HUNK_RE = re.compile(r"^@@ -(\d+)(?:,(\d+))? \+(\d+)(?:,(\d+))? @@")


def diff_hunks(*args: str) -> list[tuple[int, int, int, int]] | None:
    """``(old_start, old_count, new_start, new_count)`` of ``git diff -U0
    ARGS``, or None when git fails (e.g. a commit is not fetched)."""
    proc = subprocess.run(
        ["git", "diff", "-U0", *args], capture_output=True, text=True, check=False
    )
    if proc.returncode != 0:
        return None
    return [
        (int(m[1]), int(m[2] or 1), int(m[3]), int(m[4] or 1))
        for raw in proc.stdout.splitlines()
        if (m := _HUNK_RE.match(raw))
    ]


@cache
def submodules() -> list[tuple[str, str, str]]:
    """Return (path, host, project) for every recursive submodule."""
    raw = git(
        "submodule",
        "foreach",
        "--recursive",
        "--quiet",
        "echo $displaypath $(git remote get-url origin 2>/dev/null || true)",
        check=False,
    )
    result = []
    for line in raw.splitlines():
        parts = line.split()
        remote = parse_remote(parts[1]) if len(parts) == 2 else None
        if remote:
            result.append((parts[0], *remote))
    return result


# ---------------------------------------------------------------------------
# GitLab API
# ---------------------------------------------------------------------------
@cache
def opener() -> urllib.request.OpenerDirector:
    # urlopen builds an SSL context per request: about 10ms of CPU under the
    # GIL, which serializes the threads of parallel().
    context = ssl.create_default_context()
    return urllib.request.build_opener(urllib.request.HTTPSHandler(context=context))


def api(host: str, method: str, path: str, payload: dict | None = None) -> Any:
    """Call ``https://HOST/api/v4PATH``; raise GitLabError on failure."""
    return request(host, method, path, payload)[0]


def request(
    host: str, method: str, path: str, payload: dict | None = None
) -> tuple[Any, http.client.HTTPMessage]:
    """``api`` with the response headers too."""
    token = os.environ.get("GITLAB_TOKEN", "")
    if not token:
        fail("GITLAB_TOKEN environment variable is not set.")
    try:
        seconds = float(os.environ.get("GITLAB_TIMEOUT") or 10)
    except ValueError:
        seconds = 10
    req = urllib.request.Request(
        f"https://{host}/api/v4{path}",
        data=json.dumps(payload).encode() if payload is not None else None,
        headers={"PRIVATE-TOKEN": token, "Content-Type": "application/json"},
        method=method,
    )
    unreachable = f"GitLab unreachable ({host})"
    # Without a timeout an unrouted host (VPN down) hangs for minutes.
    try:
        with opener().open(req, timeout=seconds) as resp:
            body = resp.read()
            headers = resp.headers
            ctype = headers.get_content_type()
    except urllib.error.HTTPError as exc:
        raise http_error(exc, host, method, path) from exc
    except urllib.error.URLError as exc:
        raise GitLabError(f"{unreachable}: {exc.reason}", EXIT_UNREACHABLE) from exc
    except OSError as exc:
        # Timeouts and resets while reading are not URLErrors.
        raise GitLabError(
            f"{unreachable}: {exc or type(exc).__name__}", EXIT_UNREACHABLE
        ) from exc
    if body and ctype != "application/json":
        # A sign-in page or captive portal answers 200 with HTML.
        raise GitLabError(
            f"{host} did not answer as a GitLab API (got {ctype}); "
            "signed out of the VPN?",
            EXIT_UNREACHABLE,
        )
    return (json.loads(body) if body else None), headers


def http_error(
    exc: urllib.error.HTTPError, host: str, method: str, path: str
) -> GitLabError:
    """A short message and the exit status for an HTTP error."""
    if exc.code >= 500:
        return GitLabError(f"GitLab error on {host}: HTTP {exc.code}", EXIT_UNREACHABLE)
    ctype = exc.headers.get_content_type() if exc.headers else ""
    if ctype != "application/json":
        # GitLab's API always answers JSON: this is another forge or site.
        return GitLabError(
            f"{host} is not a GitLab server (HTTP {exc.code} with "
            f"{ctype or 'no content type'}); set GITLAB_HOST if the project's "
            "GitLab is elsewhere.",
            EXIT_NOT_GITLAB,
        )
    try:
        data = json.loads(exc.read().decode(errors="replace"))
    except ValueError:
        data = None
    msg = data.get("message") or data.get("error") if isinstance(data, dict) else None
    if not isinstance(msg, str):
        msg = json.dumps(msg) if msg else exc.reason
    if exc.code == 404 and "Project Not Found" in msg:
        # GitLab hides projects I cannot see behind the same 404.
        project = urllib.parse.unquote(path.split("/")[2])
        return GitLabError(
            f"Project {project} not found on {host}, or no access.", EXIT_NO_ACCESS
        )
    status = {401: EXIT_NO_ACCESS, 403: EXIT_NO_ACCESS, 404: EXIT_NO_MR}
    return GitLabError(
        f"HTTP {exc.code} {method} {path.partition('?')[0]}: {msg}",
        status.get(exc.code, EXIT_ERROR),
    )


@cache
def whoami(host: str) -> dict:
    return api(host, "GET", "/user")


@dataclass(frozen=True)
class Repo:
    host: str
    project: str
    path: str = "."

    def api(self, method: str, path: str = "", payload: dict | None = None) -> Any:
        """Call *path* relative to the project."""
        project = urllib.parse.quote(self.project, safe="")
        return api(self.host, method, f"/projects/{project}{path}", payload)

    def get_all(self, path: str, **params: str) -> list[dict]:
        """Every page of the list at *path*."""
        project = urllib.parse.quote(self.project, safe="")

        def page(n: int | str) -> tuple[Any, http.client.HTTPMessage]:
            qs = urllib.parse.urlencode({**params, "per_page": 100, "page": n})
            return request(self.host, "GET", f"/projects/{project}{path}?{qs}")

        items, headers = page(1)
        total = headers.get("X-Total-Pages") or ""
        if total.isdigit():
            rest = parallel(*(lambda n=n: page(n)[0] for n in range(2, int(total) + 1)))
            return [item for batch in [items, *rest] for item in batch]
        # GitLab leaves out the totals of very large lists.
        while following := headers.get("X-Next-Page"):
            batch, headers = page(following)
            items.extend(batch)
        return items

    def me(self) -> dict:
        return whoami(self.host)

    def mrs(self, state: str = "opened", **params: str) -> list[dict]:
        """MRs, most recently updated first."""
        return self.get_all(
            "/merge_requests",
            state=state,
            order_by="updated_at",
            sort="desc",
            **params,
        )

    def mr(self, iid: int, path: str = "", method: str = "GET", **payload) -> Any:
        """Call *path* relative to MR *iid* (the MR itself by default); None
        fields of *payload* are left out."""
        payload = {k: v for k, v in payload.items() if v is not None}
        return self.api(method, f"/merge_requests/{iid}{path}", payload or None)


def make_repo(host: str, project: str, path: str = ".") -> Repo:
    return Repo(os.environ.get("GITLAB_HOST") or host, project, path)


def repo_from_cwd() -> Repo:
    remote = parse_remote(git("remote", "get-url", "origin"))
    if not remote:
        fail("Cannot parse the origin remote URL.")
    return make_repo(*remote)


def parallel(*fns: Callable[[], Any]) -> list:
    """Call *fns* concurrently: GitLab calls are latency bound."""
    if len(fns) <= 1:
        return [fn() for fn in fns]
    with ThreadPoolExecutor(max_workers=16) as pool:
        return list(pool.map(lambda fn: fn(), fns))


_REF_RE = re.compile(r"(?:(?P<project>[^\s!]+)!|!)?(?P<iid>\d+)")
_URL_RE = re.compile(r"https?://[^/]+/(?P<project>.+?)/-/merge_requests/(?P<iid>\d+)")


def parse_ref(root: Repo, ref: str) -> tuple[Repo, int]:
    """Resolve an MR reference to the repository it belongs to and its IID.

    :param ref: ``IID``, ``!IID``, ``group/project!IID`` or an MR URL, of
        *root* or of one of its submodules.
    """
    m = _URL_RE.fullmatch(ref.strip().rstrip("/")) or _REF_RE.fullmatch(ref.strip())
    if not m:
        fail(f"Not an MR reference: {ref!r} (IID, !IID, group/project!IID or URL).")
    project = m["project"]
    if not project or project == root.project:
        return root, int(m["iid"])
    match = next((s for s in submodules() if s[2] == project), None)
    if not match:
        fail(f"No submodule with project {project}.")
    path, host, project = match
    return make_repo(host, project, path), int(m["iid"])


def find_mr(
    root: Repo, ref: str | int | None, ended: bool = False
) -> tuple[Repo, dict]:
    """The MR *ref* (see ``parse_ref``; an int is an IID of *root*), or the
    open MR of the current branch.

    :param ended: with no open MR, return the branch's latest merged or
        closed one (to read it, never to write to it unasked).
    """
    if isinstance(ref, int):
        return root, root.mr(ref)
    if ref is not None:
        repo, iid = parse_ref(root, ref)
        return repo, repo.mr(iid)
    branch = current_branch()
    mrs = root.mrs(source_branch=branch)
    if len(mrs) == 1:
        return root, mrs[0]
    if mrs:
        refs = ", ".join(f"!{mr['iid']}" for mr in mrs)
        fail(f"Several open MRs for branch '{branch}' ({refs}); pass one.")
    last = next(
        (
            mr
            for mr in root.mrs("all", source_branch=branch)
            if mr.get("state") in ("merged", "closed")
        ),
        None,
    )
    if last and ended:
        return root, last
    why = f": !{last['iid']} was {last['state']}" if last else ""
    fail(
        f"No open MR for branch '{branch}' in {root.project}{why} (use --mr IID).",
        EXIT_NO_MR,
    )


def find_mrs(refs: list[str]) -> list[tuple[Repo, dict]]:
    """``find_mr`` for each of *refs*; none means the current branch's MR."""
    root = repo_from_cwd()
    if not refs:
        return [find_mr(root, None)]
    return parallel(*(lambda ref=ref: find_mr(root, ref) for ref in refs))


def mr_url(repo: Repo, mr: dict) -> str:
    return (
        mr.get("web_url")
        or f"https://{repo.host}/{repo.project}/-/merge_requests/{mr['iid']}"
    )


def approvals(repo: Repo, iid: int) -> dict | None:
    """The approval state of an MR, or None where GitLab has none to give."""
    try:
        return repo.mr(iid, "/approvals")
    except GitLabError as exc:
        if exc.status == EXIT_UNREACHABLE:
            raise
        return None


def review_info(mr: dict, approval: dict | None, me: str) -> dict:
    """Who reviews *mr* and who approved it; approval fields only when known."""
    info: dict = {
        "me": me,
        "reviewers": [r["username"] for r in mr.get("reviewers") or []],
    }
    if approval is not None:
        info["approved"] = bool(approval.get("approved"))
        info["approved_by"] = [
            a["user"]["username"] for a in approval.get("approved_by") or []
        ]
        info["approvals_left"] = approval.get("approvals_left") or 0
    return info


def review_infos(owned: list[tuple[Repo, dict]]) -> list[dict]:
    """``review_info`` of each ``(repo, mr)``, one approvals request per MR."""
    if not owned:
        return []
    me, *states = parallel(
        owned[0][0].me,
        *(lambda r=r, mr=mr: approvals(r, mr["iid"]) for r, mr in owned),
    )
    return [review_info(mr, a, me["username"]) for (_, mr), a in zip(owned, states)]


def review_summary(info: dict) -> str:
    """One line: who approved, or how many approvals are left; who reviews."""
    parts = []
    if info.get("approved_by"):
        parts.append("approved by " + ", ".join("@" + u for u in info["approved_by"]))
    elif info.get("approvals_left"):
        parts.append(f"{info['approvals_left']} approval(s) left")
    reviewers = info.get("reviewers") or []
    parts.append(
        "reviewers: " + ", ".join("@" + u for u in reviewers)
        if reviewers
        else "no reviewer"
    )
    return "; ".join(parts)


def mr_info(repo: Repo, mr: dict, review: dict | None = None) -> dict:
    """What the plugin shows of *mr*; *review* adds ``review_info``'s fields."""
    return (review or {}) | {
        "ref": f"!{mr['iid']}",
        "iid": mr["iid"],
        "title": mr.get("title", ""),
        "url": mr_url(repo, mr),
        "source": mr.get("source_branch"),
        "target": f"origin/{mr['target_branch']}" if mr.get("target_branch") else None,
        "author": (mr.get("author") or {}).get("username"),
        "sha": mr.get("sha"),
        "state": mr.get("state"),
        "draft": bool(mr.get("draft")),
    }


# ---------------------------------------------------------------------------
# Inline positions
# ---------------------------------------------------------------------------
def old_line_for(base: str, head: str, path: str, line: int) -> int | None:
    """*line* of *path* at *head* mapped to *base*; None for a line the MR
    added (or when the diff cannot be computed)."""
    hunks = diff_hunks(base, head, "--", path)
    if hunks is None:
        return None
    offset = 0
    for _, old_count, new_start, new_count in hunks:
        if line < new_start or (not new_count and line == new_start):
            break
        if line < new_start + new_count:
            return None
        offset += new_count - old_count
    return line - offset


class LineMapper:
    """Maps lines of remote positions to the files on disk, one diff per
    commit and file pair (cached for a whole thread list)."""

    def __init__(self) -> None:
        self._hunks: dict[tuple, list[tuple[int, int, int, int]] | None] = {}

    def map(self, sha: str, paths: tuple[str, ...], line: int) -> int:
        """*line* of the file at *sha* on disk: a changed or removed line goes
        to where it was; unchanged when the diff cannot be computed (e.g. the
        commit is not fetched)."""
        key = (sha, paths)
        if key not in self._hunks:
            # Against the working tree: notes refer to the files as saved.
            self._hunks[key] = diff_hunks("-M", sha, "--", *paths)
        offset = 0
        for old_start, old_count, new_start, new_count in self._hunks[key] or []:
            if old_count == 0:
                # Lines inserted after old_start.
                if line <= old_start:
                    break
            else:
                if line < old_start:
                    break
                if line < old_start + old_count:
                    return max(1, new_start if new_count else new_start + 1)
            offset += new_count - old_count
        return max(1, line + offset)

    def position(self, pos: dict) -> tuple[int, int | None]:
        """``(line, start)`` on disk for a text position: its new side at its
        head commit, else (a removed line) its old side at the base commit.
        *start* is the first line of a multi-line comment, else None."""
        paths = tuple(
            dict.fromkeys(p for p in (pos.get("old_path"), pos.get("new_path")) if p)
        )

        def side(point: dict) -> int | None:
            if point.get("new_line"):
                return self.map(pos.get("head_sha") or "HEAD", paths, point["new_line"])
            if point.get("old_line"):
                return self.map(pos.get("base_sha") or "HEAD", paths, point["old_line"])
            return None

        line = side(pos) or 1
        start = side((pos.get("line_range") or {}).get("start") or {})
        return line, start if start is not None and start < line else None


# ---------------------------------------------------------------------------
# Commands: mr
# ---------------------------------------------------------------------------
def cmd_mr_list(args: argparse.Namespace) -> None:
    root = repo_from_cwd()
    repos = [root]
    if args.recursive:
        repos += [make_repo(h, p, path) for path, h, p in submodules()]
    state = "all" if args.all else "opened"
    per_repo = parallel(*(lambda r=r: r.mrs(state) for r in repos))
    seen: set[str] = set()
    owned: list[tuple[Repo, dict]] = []
    for repo, mrs in zip(repos, per_repo):
        for mr in mrs:
            url = mr.get("web_url", "")
            if url in seen or (mr.get("draft") and not args.drafts):
                continue
            seen.add(url)
            local = repo.project == root.project
            mr["_repo"] = repo.project
            mr["_path"] = repo.path
            mr["_ref"] = f"!{mr['iid']}" if local else f"{repo.project}!{mr['iid']}"
            owned.append((repo, mr))
    if args.approvals:
        # The list has no approvers: one request per MR.
        for (_, mr), review in zip(owned, review_infos(owned)):
            mr["_review"] = review
    result = [mr for _, mr in owned]
    if args.json:
        print(json.dumps(result, indent=2))
        return
    for mr in result:
        fields = [
            mr["_ref"],
            "@" + (mr.get("author") or {}).get("username", "?"),
            mr.get("source_branch", "?"),
            mr.get("title", ""),
            ", ".join(mr.get("labels") or []),
        ]
        if "_review" in mr:
            fields.append(review_summary(mr["_review"]))
        # Tabs and newlines would break the columns.
        print("\t".join(" ".join(f.split()) for f in fields))


def review_assign(repo: Repo, mr: dict, only_if_free: bool = False) -> None:
    """Add me to the reviewers of *mr*.

    :param only_if_free: refuse when someone else reviews it already (exit 1).
    """
    user = repo.me()
    reviewers = mr.get("reviewers") or []
    others = [r["username"] for r in reviewers if r["id"] != user["id"]]
    if only_if_free and others:
        fail(
            f"!{mr['iid']} is already reviewed by "
            + ", ".join("@" + u for u in others)
            + " (--force to join)"
        )
    ids = [r["id"] for r in reviewers]
    if user["id"] not in ids:
        repo.mr(mr["iid"], method="PUT", reviewer_ids=ids + [user["id"]])
    print(f"Assigned @{user['username']} as reviewer of !{mr['iid']}")


def cmd_mr_review_assign(args: argparse.Namespace) -> None:
    # Fresh from GitLab: someone may have picked it up since I looked.
    for repo, mr in find_mrs(args.refs):
        review_assign(repo, mr, only_if_free=args.if_free and not args.force)


def checkout_mr(mr: dict, path: str) -> str:
    """Check out *mr* in the repository at *path*; return the local branch."""

    # No submodule recursion (a user config may set it): an MR may point a
    # submodule at a commit no branch has, so switch would abort on it;
    # `submodule update` below fetches it by SHA instead.
    def run(*args: str, check: bool = True) -> subprocess.CompletedProcess:
        cmd = ["git", "-c", "submodule.recurse=false", "-C", path, *args]
        proc = subprocess.run(cmd, capture_output=True, text=True, check=False)
        if check and proc.returncode != 0:
            fail(
                f"git {' '.join(args)} failed in {path}:\n"
                + (proc.stderr or proc.stdout).strip()
            )
        return proc

    # Refuse on tracked changes: switch/rebase could stop halfway and leave
    # the checkout on another branch or mid-rebase.
    if run("status", "--porcelain", "--untracked-files=no").stdout.strip():
        fail(f"Uncommitted changes in {path}; commit or stash first.")

    source = mr["source_branch"]
    fork = mr.get("source_project_id") != mr.get("target_project_id")
    if fork:
        # Fork branches are not on origin; GitLab mirrors every MR head under
        # refs/merge-requests. A namespaced local branch keeps a fork's "main"
        # from clashing with ours.
        branch = f"mr/{mr['iid']}"
        upstream = f"refs/remotes/origin/{branch}"
        run("fetch", "origin", f"+refs/merge-requests/{mr['iid']}/head:{upstream}")
    else:
        branch = source
        upstream = f"refs/remotes/origin/{source}"
        run("fetch", "origin", source)

    exists = run(
        "rev-parse", "--verify", "--quiet", f"refs/heads/{branch}", check=False
    )
    if exists.returncode == 0:
        run("switch", branch)
        if run("merge", "--ff-only", upstream, check=False).returncode != 0:
            # Force-pushed upstream: the reflog of the upstream ref tells which
            # local commits were really ours (as `git pull --rebase` does).
            fp = run("merge-base", "--fork-point", upstream, "HEAD", check=False)
            fork_point = fp.stdout.strip()
            if fp.returncode != 0 or not fork_point:
                fail(
                    f"{branch} diverged from {upstream} (no fork point); resolve manually."
                )
            if fork_point == run("rev-parse", "HEAD").stdout.strip():
                run("reset", "--keep", upstream)
            else:
                print(f"Replaying local commits onto {upstream}", file=sys.stderr)
                run("rebase", "--onto", upstream, fork_point)
    elif fork:
        # No tracking: the MR ref is read-only, nothing to push back to.
        run("switch", "-c", branch, "--no-track", upstream)
    else:
        run("switch", "-c", branch, "--track", f"origin/{source}")
    # A main-repo MR may move submodule pointers.
    if path == ".":
        run("submodule", "update", "--init", "--recursive")
    return branch


def cmd_mr_checkout(args: argparse.Namespace) -> None:
    repo, mr = find_mr(repo_from_cwd(), args.ref)
    branch = checkout_mr(mr, repo.path)
    if mr.get("target_branch"):
        store_target(branch, f"origin/{mr['target_branch']}", cwd=repo.path)
    print(f"!{mr['iid']}: on {branch} in {repo.path}")
    if args.review:
        review_assign(repo, mr)


def guess_target(repo: Repo, branch: str) -> str:
    """Guess the target for a branch without an MR: the nearest protected branch.

    Exits 1 when unknown, 2 when *branch* is itself protected.
    """
    try:
        protected = {b["name"] for b in repo.get_all("/protected_branches")}
    except GitLabError:
        sys.exit(1)
    if branch in protected:
        fail(f"'{branch}' is protected and unlikely to have an MR target.", 2)
    remote = {
        ln.strip().removeprefix("origin/")
        for ln in git("branch", "-r", check=False).splitlines()
        if ln.strip().startswith("origin/") and "->" not in ln
    }
    candidates = protected & remote
    if not candidates:
        sys.exit(1)

    def ahead(b: str) -> int:
        out = git("rev-list", "--count", f"origin/{b}..HEAD", check=False)
        return int(out) if out.isdigit() else sys.maxsize

    return f"origin/{min(candidates, key=ahead)}"


def branch_target(refresh: bool) -> str:
    """The current branch's target, cached in its config."""
    branch = current_branch()
    # Targets rarely change: answer from the cache and let callers refresh it
    # in the background. Unknown/protected results are not cached.
    cached = git("config", "--get", target_key(branch), check=False)
    if cached and not refresh:
        return cached
    repo = repo_from_cwd()
    mrs = repo.mrs(source_branch=branch)
    if mrs and mrs[0].get("target_branch"):
        target = f"origin/{mrs[0]['target_branch']}"
    elif cached:
        # No MR by this name (a fork MR's mr/IID, or merged): a guess must not
        # replace what checkout or a real MR stored.
        target = cached
    else:
        target = guess_target(repo, branch)
    store_target(branch, target)
    return target


def cmd_mr_target(args: argparse.Namespace) -> None:
    """Print ``origin/<target>``; exit 1 when unknown, 2 on a protected branch."""
    if not args.refs:
        print(branch_target(args.refresh))
        return
    for _, mr in find_mrs(args.refs):
        if not mr.get("target_branch"):
            sys.exit(1)
        print(f"origin/{mr['target_branch']}")


def cmd_mr_approve(args: argparse.Namespace) -> None:
    for repo, mr in find_mrs(args.refs):
        print(f"Approving MR !{mr['iid']}: {mr.get('title', '')}\n  {mr_url(repo, mr)}")
        if args.message:
            repo.mr(mr["iid"], "/notes", "POST", body=args.message)
            print("  comment posted")
        repo.mr(mr["iid"], "/approve", "POST")
        print("  approved")


def cmd_mr_info(args: argparse.Namespace) -> None:
    root = repo_from_cwd()
    if args.refs:
        owned = find_mrs(args.refs)
    else:
        owned = [find_mr(root, None, ended=True)]
    for (repo, mr), review in zip(owned, review_infos(owned)):
        info = mr_info(repo, mr, review)
        if args.json:
            print(json.dumps(info))
            continue
        state = "" if info["state"] == "opened" else f" [{info['state']}]"
        print(
            f"{info['ref']}{state} {info['title']}\n"
            f"  {info['source']} -> {info['target']}\n"
            f"  {review_summary(review)}\n  {info['url']}"
        )


