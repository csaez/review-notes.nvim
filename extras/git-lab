def read_text(arg: str, required: bool = True) -> str:
    """*arg* itself, or all of stdin when it is ``-``."""
    text = (sys.stdin.read() if arg == "-" else arg).strip()
    if required and not text:
        fail("Empty comment text.")
    return text


def parse_location(loc: str) -> tuple[str, int]:
    path, sep, line = loc.rpartition(":")
    if not sep or not path or not line.isdigit():
        fail(f"Expected PATH:LINE, got '{loc}'.")
    return path, int(line)


def mr_paths(repo: Repo, mr: dict, refs: dict) -> set[str]:
    """New paths of the files the MR changes."""
    # Locally when the commits are fetched: the API's /diffs carries every
    # file's diff, heavy on a large MR.
    proc = subprocess.run(
        ["git", "diff", "--name-only", "-z", "-M", refs["base_sha"], refs["head_sha"]],
        capture_output=True,
        text=True,
        check=False,
    )
    if proc.returncode == 0:
        return {p for p in proc.stdout.split("\0") if p}
    return {d["new_path"] for d in repo.get_all(f"/merge_requests/{mr['iid']}/diffs")}


def inline_position(repo: Repo, mr: dict, path: str, line: int) -> dict:
    """GitLab diff position for *line* of *path* at the MR head; line 0 is
    the whole file."""
    refs = mr.get("diff_refs") or {}
    if not refs.get("head_sha"):
        fail("The MR has no diff refs yet.")
    # Line numbers only mean something when the checkout is what GitLab shows.
    if line != 0 and git("rev-parse", "HEAD") != refs["head_sha"]:
        fail(
            f"HEAD is not the MR head ({refs['head_sha'][:10]}); "
            "check out the MR branch first."
        )
    # GitLab accepts a draft on a file outside the MR and then silently drops
    # it when published, so refuse up front.
    if path not in mr_paths(repo, mr, refs):
        fail(
            f"{path} is not changed by MR !{mr['iid']}; "
            "use --general to post it as a general comment."
        )
    position = {k: refs[k] for k in ("base_sha", "start_sha", "head_sha")}
    position |= {"new_path": path, "old_path": path}
    if line == 0:
        return position | {"position_type": "file"}
    position |= {"position_type": "text", "new_line": line}
    old = old_line_for(refs["base_sha"], refs["head_sha"], path, line)
    if old is not None:
        position["old_line"] = old
    return position


def thread_json(disc: dict, me: str, lines: LineMapper) -> dict | None:
    """A GitLab discussion as ``{id, path, line, start_line, resolved,
    resolvable, resolved_by, resolved_by_me, comments = [{id, author, body,
    mine}]}``, or None when it has no comments (system notes only).
    ``resolved_by`` is the username that resolved it (None when open or
    unknown); ``mine`` and ``resolved_by_me`` compare with *me*, so callers
    can tell my own activity (in the browser too) from someone else's.

    An overview comment has path and line None; a file comment (or one on
    an image) has line 0. A line comment is mapped to the file on disk (a
    comment on a removed line, or made on an older version of the MR, lands
    where its code is now); ``start_line`` is the first line of a multi-line
    comment, else None. A one-off comment (not resolvable) counts as
    resolved when it is *me*'s (my summary, an approval message), so it does
    not come back as something to act on.
    """
    notes = [n for n in disc.get("notes") or [] if not n.get("system")]
    if not notes:
        return None
    pos = notes[0].get("position") or {}
    path = pos.get("new_path") or pos.get("old_path")
    line, start = None, None
    if path and pos.get("position_type") in ("file", "image"):
        line = 0
    elif path:
        line, start = lines.position(pos)

    def username(user: dict | None) -> str | None:
        return (user or {}).get("username")

    resolvable = any(n.get("resolvable") for n in notes)
    resolved = (
        bool(disc.get("resolved"))
        if resolvable
        else username(notes[0].get("author")) == me
    )
    # Resolving a thread sets resolved_by on each of its resolvable notes.
    resolver = None
    if resolvable and resolved:
        resolver = next(
            (u for n in reversed(notes) if (u := username(n.get("resolved_by")))), None
        )
    return {
        "id": disc["id"],
        "path": path,
        "line": line,
        "start_line": start,
        "resolved": resolved,
        "resolvable": resolvable,
        "resolved_by": resolver,
        "resolved_by_me": resolver is not None and resolver == me,
        "comments": [
            {
                "id": str(n["id"]),
                "author": username(n.get("author")) or "unknown",
                "body": n.get("body") or "",
                "mine": username(n.get("author")) == me,
            }
            for n in notes
        ],
    }


def cmd_comment_list(args: argparse.Namespace) -> None:
    repo = repo_from_cwd()
    found: dict | None = None
    if args.mr is None:
        # Threads of a merged MR stay readable; only writes need an open one.
        repo, found = find_mr(repo, None, ended=True)
    # With the iid known, the MR comes along with its threads.
    iid = found["iid"] if found else args.mr

    def mr_and_successor() -> tuple[dict, dict | None]:
        mr = found or repo.mr(iid)
        branch = mr.get("source_branch")
        if not args.with_mr or mr.get("state") not in ("merged", "closed"):
            return mr, None
        # The branch moved on to a new MR: callers must not mix the two.
        opened = repo.mrs(source_branch=branch) if branch else []
        return mr, opened[0] if opened else None

    # The MR first: when it fails, its error is the one reported.
    (mr, successor), discussions, me, approval = parallel(
        mr_and_successor,
        lambda: repo.get_all(f"/merge_requests/{iid}/discussions"),
        repo.me,
        # Approvals change while I review: every pull brings them.
        lambda: approvals(repo, iid) if args.with_mr else None,
    )
    me = me["username"]
    lines = LineMapper()
    threads = [t for d in discussions if (t := thread_json(d, me, lines))]
    if args.with_mr:
        info = mr_info(repo, mr, review_info(mr, approval, me))
        if successor:
            info["successor"] = mr_info(repo, successor)
        print(json.dumps({"mr": info, "threads": threads}, indent=2))
        return
    if args.json:
        print(json.dumps(threads, indent=2))
        return
    for t in sorted(threads, key=lambda t: (t["path"] or "", t["line"] or 0)):
        state = " [resolved]" if t["resolved"] else ""
        span = f"{t['start_line']}-{t['line']}" if t["start_line"] else t["line"]
        where = f"{t['path']}:{span}" if t["path"] else "(overview)"
        print(f"{where}{state}  ({t['id'][:8]})")
        for c in t["comments"]:
            first, *rest = c["body"].splitlines() or [""]
            print(f"  @{c['author']}: {first}")
            for line in rest:
                print(f"    {line}")


def post_comment(
    args: argparse.Namespace,
    repo: Repo,
    iid: int,
    text: str,
    position: dict | None = None,
    thread: str | None = None,
) -> None:
    """Post *text* (a draft with ``--draft``) as a new thread, at *position*
    when given, or as a reply to *thread*; print its id."""
    if args.draft:
        fields = {"note": text, "position": position}
        fields["in_reply_to_discussion_id"] = thread
        res, what = repo.mr(iid, "/draft_notes", "POST", **fields), "draft"
    elif thread:
        res = repo.mr(iid, f"/discussions/{thread}/notes", "POST", body=text)
        what = "note"
    else:
        res = repo.mr(iid, "/discussions", "POST", body=text, position=position)
        what = "thread"
    print(json.dumps({"id": str(res["id"])}) if args.json else f"{what} {res['id']}")


def cmd_comment_add(args: argparse.Namespace) -> None:
    path, line = parse_location(args.location) if args.location else (None, 0)
    text = read_text(args.text)
    repo, mr = find_mr(repo_from_cwd(), args.mr)
    if path and args.general:
        # Not anchored to the diff, so the location goes into the text.
        text = f"`{path}:{line}`\n\n{text}"
    if not path or args.general:
        # A thread on the MR itself; a draft without a position publishes as
        # a resolvable thread too.
        post_comment(args, repo, mr["iid"], text)
        return
    # The branch lookup's list entry lacks diff_refs.
    if "diff_refs" not in mr:
        mr = repo.mr(mr["iid"])
    post_comment(args, repo, mr["iid"], text, inline_position(repo, mr, path, line))


def cmd_comment_reply(args: argparse.Namespace) -> None:
    text = read_text(args.text)
    repo, mr = find_mr(repo_from_cwd(), args.mr)
    post_comment(args, repo, mr["iid"], text, thread=args.thread)


def cmd_comment_resolve(args: argparse.Namespace) -> None:
    repo, mr = find_mr(repo_from_cwd(), args.mr)
    resolved = args.cmd_name == "resolve"

    def resolve(thread: str) -> str:
        path = f"/discussions/{thread}"
        try:
            repo.mr(mr["iid"], path, "PUT", resolved=resolved)
        except GitLabError:
            # A one-off comment has no resolved state on GitLab: callers keep
            # it locally, so that is not an error.
            disc = repo.mr(mr["iid"], path)
            if any(n.get("resolvable") for n in disc.get("notes") or []):
                raise
            return f"{thread} is not resolvable on GitLab; state kept locally"
        return f"{'resolved' if resolved else 'reopened'} {thread}"

    for message in parallel(*(lambda t=t: resolve(t) for t in args.threads)):
        print(message)


def parse_ids(arg: str | None) -> set[str] | None:
    """The ids of ``--only``; None when not given."""
    if arg is None:
        return None
    ids = {i.strip() for i in arg.split(",") if i.strip()}
    if not ids:
        # Never widen an empty selection to all drafts.
        fail("--only needs at least one draft id")
    return ids


def cmd_review_submit(args: argparse.Namespace) -> None:
    repo, mr = find_mr(repo_from_cwd(), args.mr)
    iid = mr["iid"]
    pending = {str(d["id"]) for d in repo.get_all(f"/merge_requests/{iid}/draft_notes")}
    ids = parse_ids(args.only)
    if ids is not None and ids - pending:
        fail(f"not pending drafts: {', '.join(sorted(ids - pending))}")
    # `-m -` with nothing on stdin means no summary, so callers can always
    # pass the summary they have.
    summary = (
        read_text(args.message, required=args.message != "-") if args.message else ""
    )
    if summary:
        repo.mr(iid, "/notes", "POST", body=summary)
        if not args.json:
            print("summary posted")
    published: list[str] = []
    if ids is None or ids == pending:
        # One bulk publish (one notification, like the web's submit).
        if pending:
            repo.mr(iid, "/draft_notes/bulk_publish", "POST")
        published = sorted(pending)
    else:
        # One by one, so other drafts (a review started in the browser) stay
        # pending.
        for ident in sorted(ids, key=lambda i: int(i) if i.isdigit() else 0):
            try:
                repo.mr(iid, f"/draft_notes/{ident}/publish", "PUT")
            except GitLabError:
                if args.json:
                    print(json.dumps({"published": published}))
                raise
            published.append(ident)
    if args.json:
        print(json.dumps({"published": published}))
    elif not (summary or published):
        print(f"MR !{iid}: nothing to submit")
    else:
        if published:
            print(f"published {len(published)} pending comments")
        print(mr_url(repo, mr))


def cmd_review_discard(args: argparse.Namespace) -> None:
    repo, mr = find_mr(repo_from_cwd(), args.mr)
    iid = mr["iid"]
    pending = [str(d["id"]) for d in repo.get_all(f"/merge_requests/{iid}/draft_notes")]
    # A selected draft no longer pending was published or deleted already.
    ids = parse_ids(args.only)
    drop = [i for i in pending if ids is None or i in ids]
    parallel(*(lambda i=i: repo.mr(iid, f"/draft_notes/{i}", "DELETE") for i in drop))
    print(f"discarded {len(drop)} pending comments")


