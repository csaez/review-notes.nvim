#!/usr/bin/env python3
"""
git-lab -- GitLab merge request tooling for the current repository.

Subcommands:
    mr list [--all] [--drafts] [--recursive] [--json]
                            Print MRs as ref<TAB>author<TAB>branch<TAB>title<TAB>labels,
                            or JSON (with the ref as _ref).
    mr checkout REF [-r|--review]
                            Check out the MR's source branch (fork MRs as
                            mr/IID), in the submodule for a submodule's MR,
                            fast-forwarding or replaying local commits over a
                            force-push. --review: also assign yourself as
                            reviewer.
    mr review-assign REF    Add yourself as reviewer of the MR.
    mr target [REF] [--refresh]
                            Print the MR target ref (origin/<branch>) for scripting.
                            The current branch's target is cached in
                            branch.<name>.gitlab-target (set by checkout too);
                            --refresh asks GitLab and updates it.
    mr approve [REF] [-m MSG]
                            Approve the MR of the current branch, optionally commenting.
    mr info [REF] --json    The MR of the current branch: {ref, iid, title, url,
                            source, target, author, state, draft}.
    comment list [--mr IID] [--json]
                            Threads: {id, path, line, start_line, resolved,
                            resolvable, resolved_by, resolved_by_me,
                            comments = [{author, body, mine}]}. Lines are those of the files
                            on disk (start_line: multi-line comments). Overview
                            threads (the whole MR) have path and line null;
                            line 0 is about a whole file.
    comment add [--mr IID] [PATH:LINE] TEXT|- [--draft] [--general] [--json]
                            Start a thread; '-' reads the text from stdin.
                            No location starts an overview thread, ``PATH:0``
                            a file thread.
                            --draft keeps it pending until ``review submit``.
                            Files outside the MR are refused unless --general,
                            which posts an overview thread quoting PATH:LINE.
    comment reply [--mr IID] ID TEXT|- [--draft] [--json]
    comment resolve|unresolve [--mr IID] ID
    review submit [--mr IID] [-m TEXT|-] [--only IDS] [--json]
                            Publish all pending comments, with an optional summary
                            comment ('-' reads stdin; empty means none).
                            --only publishes just those drafts (comma-separated
                            ids), leaving others pending; --json prints
                            {published: [ids]}, also when it fails part way.
    review discard [--mr IID] [--only IDS]
                            Delete all pending comments, or just those drafts.

REF is an MR of this repository or of one of its submodules: IID, !IID,
group/project!IID or the MR URL. Without REF (and --mr defaults to) the open
MR of the current branch.

To pick an MR interactively, pipe ``mr list`` into a picker, e.g.:
    git-lab mr checkout "$(git-lab mr list --recursive | fzf | cut -f1)"

Environment:
    GITLAB_TOKEN   required -- token with api scope
    GITLAB_HOST    optional -- overrides the host parsed from the git remote
"""

import argparse
import json
import os
import re
import subprocess
import sys
import textwrap
from concurrent.futures import ThreadPoolExecutor
import urllib.error
import urllib.parse
import urllib.request
from dataclasses import dataclass
from typing import Any


class GitLabError(Exception):
    """Raised when a GitLab API call fails."""


# ---------------------------------------------------------------------------
# Git
# ---------------------------------------------------------------------------
def git(*args: str, cwd: str | None = None, check: bool = True) -> str:
    try:
        return subprocess.check_output(
            ["git", *args], cwd=cwd, stderr=subprocess.DEVNULL, text=True
        ).strip()
    except subprocess.CalledProcessError as exc:
        if check:
            sys.exit(f"git {' '.join(args)} failed (exit {exc.returncode})")
        return ""


def current_branch() -> str:
    branch = git("branch", "--show-current", check=False)
    # Mid-rebase HEAD is detached; the rebased branch is still the one whose
    # MR applies (same fallback in review-notes.nvim and pi).
    for state in ("rebase-merge", "rebase-apply"):
        if branch:
            break
        head = git("rev-parse", "--git-path", f"{state}/head-name", check=False)
        if head and os.path.isfile(head):
            with open(head) as fh:
                branch = fh.read().strip().removeprefix("refs/heads/")
    if not branch:
        sys.exit("Not on a named branch -- cannot auto-detect the MR.")
    return branch


def target_key(branch: str) -> str:
    return f"branch.{branch}.gitlab-target"


def store_target(branch: str, target: str, cwd: str | None = None) -> None:
    """Cache *target* in the branch config; git drops it with the branch."""
    key = target_key(branch)
    if git("config", "--get", key, cwd=cwd, check=False) != target:
        git("config", key, target, cwd=cwd, check=False)


def parse_remote(url: str) -> tuple[str, str] | None:
    """Return (host, project_path) for an SSH or HTTPS remote URL."""
    url = url.strip()
    if url.startswith("git@"):
        host, sep, path = url[4:].partition(":")
        return (host, path.removesuffix(".git")) if sep else None
    parsed = urllib.parse.urlparse(url)
    if not parsed.scheme or not parsed.netloc:
        return None
    host = parsed.netloc.rpartition("@")[2]
    return host, parsed.path.lstrip("/").removesuffix(".git")


def submodules() -> list[tuple[str, str, str]]:
    """Return (path, host, project) for every recursive submodule."""
    raw = git(
        "submodule",
        "foreach",
        "--recursive",
        "--quiet",
        "echo $displaypath $(git remote get-url origin 2>/dev/null || true)",
        check=False,
    )
    result = []
    for line in raw.splitlines():
        parts = line.split()
        remote = parse_remote(parts[1]) if len(parts) == 2 else None
        if remote:
            result.append((parts[0], *remote))
    return result


# ---------------------------------------------------------------------------
# GitLab API
# ---------------------------------------------------------------------------
@dataclass
class Repo:
    host: str
    project: str
    token: str
    path: str = "."

    @property
    def base(self) -> str:
        return f"/api/v4/projects/{urllib.parse.quote(self.project, safe='')}"

    def api(self, method: str, path: str, payload: dict | None = None) -> Any:
        url = f"https://{self.host}{path}"
        data = json.dumps(payload).encode() if payload is not None else None
        headers = {"PRIVATE-TOKEN": self.token, "Content-Type": "application/json"}
        req = urllib.request.Request(url, data=data, headers=headers, method=method)
        try:
            with urllib.request.urlopen(req) as resp:
                body = resp.read()
        except urllib.error.HTTPError as exc:
            detail = exc.read().decode(errors="replace")[:400]
            raise GitLabError(f"HTTP {exc.code} {method} {path}: {detail}") from exc
        except urllib.error.URLError as exc:
            raise GitLabError(f"Network error reaching {url}: {exc.reason}") from exc
        return json.loads(body) if body else None

    def get_all(self, path: str, params: dict | None = None) -> list[dict]:
        items: list[dict] = []
        for page in range(1, 21):  # safety cap
            qs = urllib.parse.urlencode(
                {**(params or {}), "per_page": 100, "page": page}
            )
            batch = self.api("GET", f"{path}?{qs}")
            items.extend(batch)
            if len(batch) < 100:
                break
        return items

    def mr_path(self, iid: int) -> str:
        return f"{self.base}/merge_requests/{iid}"


def repo_from_cwd(cwd: str | None = None) -> Repo:
    token = os.environ.get("GITLAB_TOKEN", "")
    if not token:
        sys.exit("GITLAB_TOKEN environment variable is not set.")
    remote = parse_remote(git("remote", "get-url", "origin", cwd=cwd))
    if not remote:
        sys.exit("Cannot parse the origin remote URL.")
    host, project = remote
    return Repo(os.environ.get("GITLAB_HOST") or host, project, token)


def or_exit(fn, *args, **kwargs):
    try:
        return fn(*args, **kwargs)
    except GitLabError as exc:
        sys.exit(str(exc))


def list_mrs(repo: Repo, state: str = "opened") -> list[dict]:
    return or_exit(
        repo.get_all,
        f"{repo.base}/merge_requests",
        {"state": state, "order_by": "updated_at", "sort": "desc"},
    )


def get_mr(repo: Repo, iid: int) -> dict:
    return or_exit(repo.api, "GET", repo.mr_path(iid))


def mrs_for_branch(repo: Repo, branch: str) -> list[dict]:
    return or_exit(
        repo.get_all,
        f"{repo.base}/merge_requests",
        {"source_branch": branch, "state": "opened"},
    )


def project_repo(repo: Repo, project: str | None) -> Repo:
    """Return *repo*, or the submodule whose origin is *project*."""
    if not project or project == repo.project:
        return repo
    match = next((s for s in submodules() if s[2] == project), None)
    if not match:
        sys.exit(f"No submodule with project {project}.")
    path, host, project = match
    return Repo(os.environ.get("GITLAB_HOST") or host, project, repo.token, path)


_REF_RE = re.compile(r"(?:(?P<project>[^\s!]+)!|!)?(?P<iid>\d+)")
_URL_RE = re.compile(r"https?://[^/]+/(?P<project>.+?)/-/merge_requests/(?P<iid>\d+)")


def parse_ref(root: Repo, ref: str) -> tuple[Repo, int]:
    """Resolve an MR reference to the repository it belongs to and its IID.

    :param ref: ``IID``, ``!IID``, ``group/project!IID`` or an MR URL, of
        *root* or of one of its submodules.
    """
    m = _URL_RE.fullmatch(ref.strip().rstrip("/")) or _REF_RE.fullmatch(ref.strip())
    if not m:
        sys.exit(f"Not an MR reference: {ref!r} (IID, !IID, group/project!IID or URL).")
    return project_repo(root, m["project"]), int(m["iid"])


def mr_ref(repo: Repo, root: Repo, iid: int) -> str:
    """Short reference to an MR, qualified only outside *root*'s project."""
    return f"!{iid}" if repo.project == root.project else f"{repo.project}!{iid}"


def collect_mrs(
    repo: Repo, recursive: bool, state: str = "opened", drafts: bool = False
) -> list[dict]:
    """MRs of *repo* (and its submodules), tagged with ``_repo`` and ``_path``."""
    repos = [repo]
    if recursive:
        host_override = os.environ.get("GITLAB_HOST")
        repos += [
            Repo(host_override or h, p, repo.token, path) for path, h, p in submodules()
        ]
    # One request per project, latency bound: fetch them concurrently.
    with ThreadPoolExecutor(max_workers=8) as pool:
        per_repo = list(pool.map(lambda r: list_mrs(r, state), repos))
    seen: set[str] = set()
    result: list[dict] = []
    for r, mrs in zip(repos, per_repo):
        for mr in mrs:
            url = mr.get("web_url", "")
            if url in seen or (mr.get("draft") and not drafts):
                continue
            seen.add(url)
            mr["_repo"] = r.project
            mr["_path"] = r.path
            mr["_ref"] = mr_ref(r, repo, mr["iid"])
            result.append(mr)
    return result


def resolve_mr(repo: Repo, iid: int | None, full: bool = False) -> dict:
    """Return the MR with *iid*, or the open MR of the current branch.

    :param full: fetch the whole MR even when the branch lookup found it; the
        list entry lacks ``diff_refs``.
    """
    if iid is not None:
        return get_mr(repo, iid)
    branch = current_branch()
    mrs = mrs_for_branch(repo, branch)
    if not mrs:
        sys.exit(f"No open MR for branch '{branch}' in {repo.project} (use --mr IID).")
    if len(mrs) > 1:
        refs = ", ".join(f"!{mr['iid']}" for mr in mrs)
        sys.exit(f"Several open MRs for branch '{branch}' ({refs}); pass one.")
    return get_mr(repo, mrs[0]["iid"]) if full else mrs[0]


def mr_url(repo: Repo, mr: dict) -> str:
    return (
        mr.get("web_url")
        or f"https://{repo.host}/{repo.project}/-/merge_requests/{mr['iid']}"
    )


# ---------------------------------------------------------------------------
# Inline positions
# ---------------------------------------------------------------------------
_HUNK_RE = re.compile(r"^@@ -(\d+)(?:,(\d+))? \+(\d+)(?:,(\d+))? @@")


def old_line_for(base: str, head: str, path: str, line: int) -> tuple[bool, int | None]:
    """
    Map *line* of *path* at *head* to its line at *base*.

    :return: ``(ok, old_line)``; ``old_line`` is None for lines the MR added,
        ``ok`` is False when the diff could not be computed.
    """
    proc = subprocess.run(
        ["git", "diff", "-U0", base, head, "--", path],
        capture_output=True,
        text=True,
        check=False,
    )
    if proc.returncode != 0:
        return False, None
    offset = 0
    for raw in proc.stdout.splitlines():
        m = _HUNK_RE.match(raw)
        if not m:
            continue
        old_count = int(m[2]) if m[2] is not None else 1
        new_start, new_count = int(m[3]), int(m[4]) if m[4] is not None else 1
        before = line < new_start if new_count else line <= new_start
        if before:
            break
        if line < new_start + new_count:
            return True, None
        offset += new_count - old_count
    return True, line - offset


class LineMapper:
    """Maps lines of remote positions to the files on disk, one diff per
    commit and file pair (cached for a whole thread list)."""

    def __init__(self) -> None:
        self._hunks: dict[
            tuple[str, tuple[str, ...]], list[tuple[int, int, int, int]] | None
        ] = {}

    def _diff(
        self, sha: str, paths: tuple[str, ...]
    ) -> list[tuple[int, int, int, int]] | None:
        key = (sha, paths)
        if key not in self._hunks:
            # Against the working tree: notes refer to the files as saved.
            proc = subprocess.run(
                ["git", "diff", "-U0", "-M", sha, "--", *paths],
                capture_output=True,
                text=True,
                check=False,
            )
            hunks = None
            if proc.returncode == 0:
                hunks = []
                for raw in proc.stdout.splitlines():
                    if m := _HUNK_RE.match(raw):
                        hunks.append(
                            (
                                int(m[1]),
                                int(m[2]) if m[2] is not None else 1,
                                int(m[3]),
                                int(m[4]) if m[4] is not None else 1,
                            )
                        )
            self._hunks[key] = hunks
        return self._hunks[key]

    def map(self, sha: str, paths: tuple[str, ...], line: int) -> int:
        """*line* of the file at *sha* on disk: a changed or removed line goes
        to where it was; unchanged when the diff cannot be computed (e.g. the
        commit is not fetched)."""
        hunks = self._diff(sha, paths)
        if hunks is None:
            return line
        offset = 0
        for old_start, old_count, new_start, new_count in hunks:
            if old_count == 0:
                # Lines inserted after old_start.
                if line <= old_start:
                    break
            else:
                if line < old_start:
                    break
                if line < old_start + old_count:
                    return max(1, new_start if new_count else new_start + 1)
            offset += new_count - old_count
        return max(1, line + offset)

    def position(self, pos: dict) -> tuple[int, int | None]:
        """``(line, start)`` on disk for a text position: its new side at its
        head commit, else (a removed line) its old side at the base commit.
        *start* is the first line of a multi-line comment, else None."""
        paths = tuple(
            dict.fromkeys(p for p in (pos.get("old_path"), pos.get("new_path")) if p)
        )

        def side(point: dict) -> int | None:
            if point.get("new_line"):
                return self.map(pos.get("head_sha") or "HEAD", paths, point["new_line"])
            if point.get("old_line"):
                return self.map(pos.get("base_sha") or "HEAD", paths, point["old_line"])
            return None

        line = side(pos) or 1
        start = side((pos.get("line_range") or {}).get("start") or {})
        return line, start if start is not None and start < line else None


